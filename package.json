{
  "name": "fomo-events",
  "version": "0.1.0",
  "private": true,
  "description": "A public French Riviera installation of the FOMO Agent event radar.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run prepare:data",
    "dev": "vite --config vite.config.ts",
    "prepare:data": "tsx scripts/prepare-site-data.ts",
    "build": "npm run prepare:data && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "tsx scripts/validate-local-data.ts",
    "validate:agent": "tsx scripts/validate-with-fomo-agent.ts",
    "check": "npm run validate:data && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
