# Copy this versioned template to ~/.config/systemd/user/fomo-events-scan.timer.
# The initial schedule is every Monday at 08:30 Europe/Paris. Adjust it to taste.

[Unit]
Description=Weekly timer for the local FOMO Côte d’Azur scan

[Timer]
OnCalendar=Mon *-*-* 08:30:00 Europe/Paris
Persistent=true
Unit=fomo-events-scan.service

[Install]
WantedBy=timers.target
